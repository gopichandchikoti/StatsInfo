<Window x:Class="StatsInfo.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:StatsInfo.Views"
 xmlns:converters="clr-namespace:StatsInfo.Converters"
 Title="StatsInfo Overlay" Icon="pack://application:,,,/StatsInfo;component/Assets/StatsInfo.ico"
 Width="780" Height="72" SizeToContent="Manual" ResizeMode="NoResize"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 Topmost="{Binding IsPinned}" ShowInTaskbar="False" WindowStartupLocation="Manual">
 <Window.Resources>
  <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
  <SolidColorBrush x:Key="OverlayBackground" Color="#1E1E2E"/>
  <SolidColorBrush x:Key="OverlayForeground" Color="#CDD6F4"/>
  <SolidColorBrush x:Key="OverlayAccent" Color="#89B4FA"/>
 </Window.Resources>
 <Border x:Name="OverlayBorder" Background="{DynamicResource OverlayBackground}"
  BorderBrush="{DynamicResource OverlayAccent}" BorderThickness="1" CornerRadius="14"
  Opacity="{Binding Opacity}" Padding="12,6">
  <Grid x:Name="OverlayGrid">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <ScrollViewer x:Name="MetricScroller" Grid.Column="0"
    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
    PreviewMouseLeftButtonDown="DragHandle_MouseLeftButtonDown">
    <ItemsControl x:Name="MetricItems" ItemsSource="{Binding VisibleMetrics}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><views:ResponsiveMetricPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <Border Padding="5,3" Margin="{DynamicResource MetricSpacing}" ToolTip="{Binding Tooltip}"
       MouseRightButtonUp="Metric_RightClick" Cursor="Hand">
       <Border.Style><Style TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers><DataTrigger Binding="{Binding IsAlert}" Value="True">
         <Setter Property="Background" Value="#88521F26"/>
        </DataTrigger></Style.Triggers>
       </Style></Border.Style>
       <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding DisplayLabel}" Foreground="{DynamicResource OverlayAccent}"
         FontWeight="SemiBold" Margin="0,0,5,0" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding ValueText}" Foreground="{DynamicResource OverlayForeground}"
         FontWeight="SemiBold" MinWidth="32" MaxWidth="270" TextTrimming="CharacterEllipsis"
         Typography.NumeralAlignment="Tabular"/>
        <views:MetricSparkline Samples="{Binding Trend}" Width="70" Height="18" Margin="5,0,0,0"
         Visibility="{Binding HasSparkline, Converter={StaticResource BoolToVis}}"
         LineBrush="{DynamicResource OverlayAccent}"/>
       </StackPanel>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </ScrollViewer>
   <StackPanel x:Name="OverlayFooter" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="3,0,10,0">
    <Button Click="SettingsButton_Click" Content="⚙" Width="28" Height="24"
     ToolTip="Settings" AutomationProperties.Name="Settings"
     Background="Transparent" Foreground="{DynamicResource OverlayForeground}" BorderThickness="0"/>
    <Button Click="CloseButton_Click" Content="×" Width="24" Height="24"
     ToolTip="Close StatsInfo" AutomationProperties.Name="Close StatsInfo"
     Background="Transparent" Foreground="#F38BA8" BorderThickness="0"/>
   </StackPanel>
   <Thumb x:Name="ResizeHandle" Grid.Column="1" Width="16" Height="16"
    HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"
    ToolTip="Drag to resize. Metrics wrap to fit." AutomationProperties.Name="Resize overlay"
    DragStarted="ResizeHandle_DragStarted" DragDelta="ResizeHandle_DragDelta" DragCompleted="ResizeHandle_DragCompleted">
    <Thumb.Template><ControlTemplate TargetType="Thumb">
     <Grid Background="Transparent"><Path Data="M 4,14 L 14,4 M 9,14 L 14,9"
      Stroke="{DynamicResource OverlayAccent}" StrokeThickness="1.5"/></Grid>
    </ControlTemplate></Thumb.Template>
   </Thumb>
  </Grid>
 </Border>
</Window>
