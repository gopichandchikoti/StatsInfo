<Window x:Class="StatsInfo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:StatsInfo.ViewModels"
        xmlns:converters="clr-namespace:StatsInfo.Converters"
        mc:Ignorable="d"
        Title="StatsInfo Overlay"
        Height="36"
        Width="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="{Binding IsPinned}"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border Background="#DD1E1E2E"
            BorderBrush="#44FFFFFF"
            BorderThickness="1"
            CornerRadius="18"
            Opacity="{Binding Opacity}"
            Padding="14,0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Opacity="0.4" Color="#000000"/>
        </Border.Effect>

        <Grid VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                
                <!-- CPU -->
                <TextBlock Text="{Binding CpuText}" 
                           Foreground="#A6E3A1" 
                           FontWeight="SemiBold" 
                           FontSize="12" 
                           FontFamily="Segoe UI, Inter, Arial"
                           VerticalAlignment="Center"
                           Visibility="{Binding ShowCpu, Converter={StaticResource BoolToVis}}"/>

                <TextBlock Text=" · " Foreground="#6C7086" VerticalAlignment="Center" Margin="6,0"
                           Visibility="{Binding ShowCpu, Converter={StaticResource BoolToVis}}"/>

                <!-- GPU -->
                <TextBlock Text="{Binding GpuText}" 
                           Foreground="#89B4FA" 
                           FontWeight="SemiBold" 
                           FontSize="12" 
                           FontFamily="Segoe UI, Inter, Arial"
                           VerticalAlignment="Center"
                           Visibility="{Binding ShowGpu, Converter={StaticResource BoolToVis}}"/>

                <TextBlock Text=" | " Foreground="#585B70" VerticalAlignment="Center" Margin="8,0"/>

                <!-- RAM -->
                <TextBlock Text="{Binding RamText}" 
                           Foreground="#FAB387" 
                           FontWeight="SemiBold" 
                           FontSize="12" 
                           FontFamily="Segoe UI, Inter, Arial"
                           VerticalAlignment="Center"
                           Visibility="{Binding ShowRam, Converter={StaticResource BoolToVis}}"/>

                <TextBlock Text=" | " Foreground="#585B70" VerticalAlignment="Center" Margin="8,0"/>

                <!-- Network -->
                <TextBlock Text="{Binding NetworkText}" 
                           Foreground="#F9E2AF" 
                           FontWeight="SemiBold" 
                           FontSize="12" 
                           FontFamily="Segoe UI, Inter, Arial"
                           VerticalAlignment="Center"
                           Visibility="{Binding ShowNetwork, Converter={StaticResource BoolToVis}}"/>

                <TextBlock Text=" | " Foreground="#585B70" VerticalAlignment="Center" Margin="8,0"/>

                <!-- Display Hz -->
                <TextBlock Text="{Binding DisplayHzText}" 
                           Foreground="#CBA6F7" 
                           FontWeight="SemiBold" 
                           FontSize="12" 
                           FontFamily="Segoe UI, Inter, Arial"
                           VerticalAlignment="Center"
                           Visibility="{Binding ShowDisplayHz, Converter={StaticResource BoolToVis}}"/>

                <!-- Settings Gear Button -->
                <Button Command="{Binding OpenSettingsCommand}" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        Foreground="#BAC2DE" 
                        FontSize="11"
                        Cursor="Hand"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        ToolTip="Settings">
                    <TextBlock Text="⚙"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
