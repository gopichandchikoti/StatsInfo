<Window x:Class="StatsInfo.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StatsInfo Settings"
        Icon="Assets/StatsInfo.ico"
        Height="480"
        Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#181825"
        Foreground="#CDD6F4"
        FontFamily="Segoe UI, Inter, Arial">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Overlay Preferences" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

        <!-- Settings List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Opacity -->
                <TextBlock Text="Opacity" FontWeight="SemiBold"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0" Minimum="0.2" Maximum="1.0" Value="{Binding Opacity}" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                    <TextBlock Grid.Column="1" Text="{Binding Opacity, StringFormat={}{0:P0}}" HorizontalAlignment="Right"/>
                </Grid>

                <!-- Update Interval -->
                <TextBlock Text="Update Interval (ms)" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0" Minimum="500" Maximum="5000" Value="{Binding UpdateIntervalMs}" TickFrequency="250" IsSnapToTickEnabled="True"/>
                    <TextBlock Grid.Column="1" Text="{Binding UpdateIntervalMs}" HorizontalAlignment="Right"/>
                </Grid>

                <Separator Background="#313244" Margin="0,8"/>

                <!-- Options -->
                <CheckBox Content="Always on Top" IsChecked="{Binding AlwaysOnTop}" Foreground="#CDD6F4" Margin="0,4"/>
                <CheckBox Content="Click-Through Mode" IsChecked="{Binding ClickThrough}" Foreground="#CDD6F4" Margin="0,4"/>

                <Separator Background="#313244" Margin="0,8"/>

                <!-- Visible Metrics -->
                <TextBlock Text="Visible Metrics" FontWeight="SemiBold"/>
                <CheckBox Content="Show CPU Usage &amp; Clock" IsChecked="{Binding ShowCpu}" Foreground="#CDD6F4" Margin="0,4"/>
                <CheckBox Content="Show GPU Usage &amp; Temp" IsChecked="{Binding ShowGpu}" Foreground="#CDD6F4" Margin="0,4"/>
                <CheckBox Content="Show RAM Usage" IsChecked="{Binding ShowRam}" Foreground="#CDD6F4" Margin="0,4"/>
                <CheckBox Content="Show Network Throughput" IsChecked="{Binding ShowNetwork}" Foreground="#CDD6F4" Margin="0,4"/>
                <CheckBox Content="Show Display Refresh Rate (Hz)" IsChecked="{Binding ShowDisplayHz}" Foreground="#CDD6F4" Margin="0,4"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" Width="80" Height="30" Margin="0,0,10,0" Background="#313244" Foreground="#CDD6F4" BorderThickness="0"/>
            <Button Content="Save" Command="{Binding SaveCommand}" Width="80" Height="30" Background="#89B4FA" Foreground="#11111B" FontWeight="SemiBold" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
